<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="5dp"
    card_view:cardUseCompatPadding="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvIdUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆔 ID: 1"
                android:textSize="13sp"
                android:textColor="#666666"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Usuário: João Silva"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvEmailUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📧 Email: joao.silva@email.com"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSenhaUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 Senha: ********"
                android:textSize="12sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvTipoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🩺 Tipo: Médico"
                android:textSize="12sp"
                android:textColor="@color/light_theme_button_background"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
